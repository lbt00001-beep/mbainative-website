# Configura estos valores en el entorno de ejecución de Hostinger.
# No subas credenciales reales al repositorio.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# TradingAlpha requiere la clave personal del visitante en Ajustes.
# La web pública no utiliza OPENROUTER_API_KEY del servidor.

# Asistente de lectura: configura uno de los proveedores para voces profesionales.
# Las credenciales son exclusivas del servidor. Sin ellas se ofrecen voces del navegador.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=
# Límite de caracteres generados por día y proceso (no es una cuota distribuida).
ASSISTANT_DAILY_CHAR_LIMIT=100000
