# --- Imprescindibles ---
OPENROUTER_API_KEY=sk-or-...
SECRET_KEY=pon-aqui-una-cadena-larga-y-aleatoria
DATABASE_URL=postgresql://usuario:clave@host/pupitre?sslmode=require
APP_URL=https://pupitre-xxxxx.europe-west1.run.app

# --- Recomendables ---
SIGNUP_CODE=codigo-para-dejar-registrarse      # vacío = registro abierto
CRON_TOKEN=otra-cadena-aleatoria               # para el informe semanal
DAILY_AI_LIMIT=400                             # consultas IA por familia y día

# --- Email (informe al profesor). Ejemplo con Gmail y "contraseña de aplicación" ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
SMTP_FROM=tu-cuenta@gmail.com

# --- Modelos (opcional: estos son los valores por defecto) ---
MODEL_MAIN=google/gemini-3.1-flash-lite
MODEL_FALLBACK=deepseek/deepseek-v4.1-flash
MODEL_VISION=google/gemini-3.1-flash-lite

